# OpenAI API Configuration
OPENAI_ORG_ID=your_openai_organization_id_here
OPENAI_API_KEY=your_openai_api_key_here

# Alpaca Trading API Configuration
ALPACA_API_KEY_ID=your_alpaca_api_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Firebase Functions Config (for local testing)
# Use: firebase functions:config:get > .runtimeconfig.json
# Or set manually with:
# firebase functions:config:set openai.id="..." openai.key="..."
# firebase functions:config:set alpaca.id="..." alpaca.key="..."
